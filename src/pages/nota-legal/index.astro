---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import TextBody from '../../components/TextBody.astro';
import { getPage } from '../../lib/data';

const page = await getPage('nota-legal');
if (!page) throw new Error('Missing content: src/content/pages/nota-legal.json');
---

<BaseLayout title={page.title} description={page.summary}>
  <PageHeader title={page.title} />
  <section class="mx-auto max-w-4xl px-4 py-12">
    <TextBody body={page.body} />
  </section>
</BaseLayout>
