---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import TextBody from '../../components/TextBody.astro';
import { getActivities } from '../../lib/data';

const activities = await getActivities();
---

<BaseLayout title="Activitats" description="Activitats del Centre d'Estudis Mollet">
  <PageHeader title="Activitats" text="Projectes i activitats que van més enllà de l'aula." />
  <section class="mx-auto max-w-6xl space-y-12 px-4 py-12">
    {activities.map((a) => (
      <article class="grid min-w-0 grid-cols-1 gap-8 md:grid-cols-2">
        <img src={a.imageUrl} alt="" loading="lazy" class="aspect-[4/3] w-full min-w-0 rounded-blob object-cover shadow-xl" />
        <div class="min-w-0">
          <h2 class="mb-4 text-3xl font-bold">{a.title}</h2>
          <TextBody body={a.body} />
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
