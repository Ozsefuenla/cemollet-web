---
import { url } from '../lib/url';

interface Props {
  title: string;
  text?: string;
  href?: string;
  label?: string;
}

const { title, text, href = '/contacte', label = 'Contacta' } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4">
  <div class="relative overflow-hidden rounded-blob bg-brand-700 px-8 py-12 text-white shadow-xl md:px-14">
    <div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-blob bg-accent-yellow/40 blur-xl"></div>
    <div class="relative flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <h2 class="text-3xl font-bold text-white md:text-4xl">{title}</h2>
        {text && <p class="mt-3 max-w-prose text-lg text-white">{text}</p>}
      </div>
      <a href={url(href)} class="shrink-0 rounded-full bg-accent-yellow px-6 py-3 font-display font-bold text-slate-900 shadow-md transition hover:-translate-y-0.5">
        {label}
      </a>
    </div>
  </div>
</section>
