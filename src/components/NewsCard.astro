---
import { url } from '../lib/url';
import type { NewsDto } from '../lib/types';

interface Props {
  news: NewsDto;
}

const { news } = Astro.props;
const date = new Intl.DateTimeFormat('ca-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(
  new Date(`${news.publishedAt}T00:00:00`),
);
---

<article class="flex h-full flex-col overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-slate-200 transition duration-300 hover:-translate-y-1 hover:shadow-xl">
  <a href={url(`/noticies/${news.slug}`)} class="block overflow-hidden" aria-label={news.title} tabindex="-1">
    <img src={news.imageUrl} alt="" loading="lazy" class="aspect-video w-full object-cover transition duration-500 hover:scale-105" />
  </a>
  <div class="flex flex-1 flex-col p-5">
    <time datetime={news.publishedAt} class="text-sm font-semibold text-brand-600">{date}</time>
    <h3 class="mt-2 text-xl font-bold leading-snug">
      <a href={url(`/noticies/${news.slug}`)} class="hover:text-brand-700 focus-visible:rounded">{news.title}</a>
    </h3>
    <p class="mt-2 line-clamp-3 text-slate-700">{news.summary}</p>
  </div>
</article>
