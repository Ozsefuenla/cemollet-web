---
import { url } from '../lib/url';
import type { StageDto } from '../lib/types';

interface Props {
  stage: StageDto;
  accent?: 'yellow' | 'coral' | 'green' | 'sky';
}

const { stage, accent = 'yellow' } = Astro.props;

const badges = {
  yellow: 'bg-accent-yellow text-slate-900',
  coral: 'bg-accent-coral text-slate-900',
  green: 'bg-accent-green text-slate-900',
  sky: 'bg-accent-sky text-slate-900',
};
---

<article class="flex h-full flex-col overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-slate-200 transition duration-300 hover:-translate-y-1 hover:shadow-xl">
  <img src={stage.imageUrl} alt="" loading="lazy" class="aspect-video w-full object-cover" />
  <div class="flex flex-1 flex-col p-6">
    <span class={`mb-3 inline-block w-fit rounded-full px-3 py-1 text-sm font-bold ${badges[accent]}`}>{stage.title}</span>
    <p class="flex-1 text-slate-700">{stage.summary}</p>
    <a href={url(`/etapes/${stage.slug}`)} class="mt-5 font-display font-bold text-brand-700 hover:underline focus-visible:rounded">
      Descobreix l'etapa <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
