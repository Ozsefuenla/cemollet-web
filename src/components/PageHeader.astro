---
interface Props {
  title: string;
  text?: string;
}

const { title, text } = Astro.props;
---

<section class="bg-gradient-to-br from-brand-50 via-white to-accent-sky/20">
  <div class="mx-auto max-w-6xl px-4 py-14">
    <h1 class="text-4xl font-bold md:text-5xl">{title}</h1>
    {text && <p class="mt-4 max-w-prose text-lg text-slate-700">{text}</p>}
  </div>
</section>
